{
  "name": "orbital-library",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-pdfjs-assets.mjs",
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "prebuild": "node scripts/sync-pdfjs-assets.mjs",
    "build": "tsc -b && vite build",
    "mobile:build": "npm run build && cap sync android",
    "mobile:assemble": "npm run mobile:build && cd android && ./gradlew assembleDebug",
    "mobile:publish": "npm run mobile:assemble && node scripts/publish-android-apk.mjs",
    "mobile:sync": "cap sync android",
    "mobile:open": "cap open android",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "tsx server/index.ts",
    "test": "npm run test:routing && npm run test:reader-settings && npm run test:reader-gestures && npm run test:reader-preferences && npm run test:auth && npm run test:cbz && npm run test:media-version && npm run test:rate-limit && npm run test:scan-status && npm run test:search",
    "test:routing": "tsx --test server/routing.test.ts",
    "test:reader-settings": "tsx --test src/readerSettings.test.ts",
    "test:reader-gestures": "tsx --test src/readerGestures.test.ts",
    "test:reader-preferences": "tsx --test server/readerPreferences.test.ts",
    "test:auth": "tsx --test server/authSecurity.test.ts",
    "test:cbz": "tsx --test server/cbzArchive.test.ts",
    "test:media-version": "tsx --test server/mediaVersion.test.ts",
    "test:rate-limit": "tsx --test server/rateLimit.test.ts",
    "test:scan-status": "tsx --test server/scanStatus.test.ts",
    "test:search": "tsx --test server/searchIndex.test.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.1.2",
    "@napi-rs/canvas": "^0.1.97",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.8.0",
    "cookie": "^1.1.1",
    "epubjs": "^0.3.93",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "mime-types": "^3.0.2",
    "pdfjs-dist": "^5.5.207",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@eslint/js": "^9.39.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie": "^0.6.0",
    "@types/express": "^5.0.6",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1"
  }
}
