# Copy to .env and adjust. Docker Compose and `npm run dev` both read it.
# Every option is described in the README.

# ---------------------------------------------------------------- required --
# Password for the first admin account (created on the first start only).
APP_ADMIN_PASSWORD=

# ---------------------------------------------------------- docker compose --
# Publish the port on localhost only; put a reverse proxy in front for HTTPS.
HOST_BIND_ADDR=127.0.0.1
HOST_PORT=4310
# Host folders for Orbital's data and for your media (mounted read-only).
APP_DATA_HOST_DIR=./data
MEDIA_HOST_DIR=./library

# To mount an SMB/CIFS share directly, start with
#   docker compose -f compose.yaml -f compose.nas.yaml up -d
# and set:
# NAS_SHARE=//nas-host/share
# NAS_MEDIA_DISPLAY_PATH=//nas-host/share/media
# NAS_MEDIA_CONTAINER_PATH=/media/library
# NAS_SMB_VERSION=3.0
# NAS_USERNAME=
# NAS_PASSWORD=

# ------------------------------------------------------------------ server --
PORT=4300
APP_NAME=Orbital Library
APP_ADMIN_USERNAME=admin
# 1 lets anyone who can reach the server create a reader account.
APP_OPEN_SIGNUP=0
# Name of the media storage in the admin screens.
APP_MEDIA_ROOT_LABEL=Library

# Behind an HTTPS reverse proxy set all three to 1.
APP_COOKIE_SECURE=0
APP_TRUST_PROXY=0
APP_ENABLE_HSTS=0

# Origins the Android app calls the API from.
APP_MOBILE_ORIGINS=https://localhost,capacitor://localhost

# Online metadata (AniList, Google Books). Leave empty to decide in
# Admin → Metadata (off by default); 1 or 0 forces it on or off.
APP_REMOTE_METADATA=

# HTTPS address of an Android APK, used when none is uploaded in Admin → System.
APP_ANDROID_APK_URL=

# ------------------------------------------------------------------ tuning --
# APP_CBZ_PAGE_CACHE_MB=96
# APP_CBZ_READ_AHEAD_PAGES=4

# ----------------------------------------------------------- android build --
# Pre-fill a server address in a self-built APK. The app asks otherwise.
# VITE_ORBITAL_API_BASE_URL=https://library.example.com
